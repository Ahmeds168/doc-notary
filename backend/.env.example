# ---------------------------------------------------------------------------
# Required — the server refuses to start if any of these are missing/invalid.
# ---------------------------------------------------------------------------

# Comma-separated list of EXACT allowed browser origins (no wildcards, no paths).
# Vercel preview deployments are not allowed unless you list them explicitly.
CORS_ORIGIN=https://doc-notary.vercel.app

# Cloudflare R2 (S3-compatible). The bucket must NOT have public access enabled.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=doc-notary-files

# Supabase (service role key is backend-only — never put it in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Blockchain (Sepolia testnet). PRIVATE_KEY is the relayer wallet that pays gas.
SEPOLIA_RPC_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=0x2c6008c33958949E69019797E39C572BB84f6589

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------
# NODE_ENV=development
# PORT=4000
# Allow http://localhost:* and http://127.0.0.1:* origins (default: true unless NODE_ENV=production)
# CORS_ALLOW_LOCALHOST=true
# Number of proxy hops in front of the app, for per-IP rate limits (default: 1 in production)
# TRUST_PROXY=1

# Operator ceiling on upload size; plans can only be lower (free 5MB, standard 25MB)
# MAX_FILE_SIZE_BYTES=26214400

# Relayer spending limits (enforced in Postgres across all instances)
# RELAYER_DAILY_BUDGET_ETH=0.05
# RELAYER_MAX_TX_COST_ETH=0.002
# MAX_IN_FLIGHT_PER_USER=2
# RELAYER_LEASE_TTL_SECONDS=60
# RELAYER_LEASE_WAIT_MS=15000

# Per-instance burst limits (abuse protection; quotas are separate)
# RATE_LIMIT_NOTARIZE_PER_MINUTE=5
# RATE_LIMIT_VERIFY_PER_MINUTE=60

# Signed download URL lifetime
# DOWNLOAD_URL_TTL_SECONDS=300

# How long verification waits for Supabase metadata before answering without it
# METADATA_TIMEOUT_MS=3000

# Reconciler (0 disables the background loop)
# RECONCILE_INTERVAL_MS=60000
# RECONCILE_STALE_AFTER_MS=600000
# TX_RECEIPT_TIMEOUT_MS=90000
# Block the contract was deployed in — bounds event-log scans during reconciliation
# CONTRACT_DEPLOY_BLOCK=
# Chain id the relayer signs for (Sepolia)
# CHAIN_ID=11155111

# Network details shown on certificates and in the UI. Change together with CHAIN_ID,
# CONTRACT_ADDRESS and SEPOLIA_RPC_URL when moving networks (e.g. Base mainnet).
# NETWORK_NAME=Ethereum Sepolia (test network)
# EXPLORER_URL=https://sepolia.etherscan.io
# Test-network notice on certificates (default: derived from CHAIN_ID)
# NETWORK_IS_TESTNET=true
# Frontend URL for verify links / QR codes on certificates (default: first CORS_ORIGIN)
# PUBLIC_APP_URL=https://doc-notary.vercel.app

# Plan source: keep "local" — profiles.plan, which the Kelviq sync below keeps up to date.
# ENTITLEMENTS_PROVIDER=local

# Kelviq billing (merchant of record). Without KELVIQ_API_KEY paid checkout is switched off.
# Use the SERVER API key (never the client key, never in the frontend).
# KELVIQ_API_KEY=
# Optional: signing secret of a Kelviq webhook pointed at https://<backend>/api/billing/webhook
# KELVIQ_WEBHOOK_SECRET=
# Kelviq plan identifier sold as "Standard" (default standard-plan)
# KELVIQ_STANDARD_PLAN=standard-plan
# How often /api/me re-checks a user's subscription, in ms (default 10 minutes)
# BILLING_SYNC_INTERVAL_MS=600000
